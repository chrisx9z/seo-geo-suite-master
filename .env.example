# ==============================================================================
# MASTER AUTO SEO GEO SUITE - ENVIRONMENT TEMPLATE
# Copy to .env and fill in your private credentials (ignored by git)
# ==============================================================================

# WordPress Admin Credentials
WP_SITE_URL=https://yourdomain.com
WP_ADMIN_USER=your_admin_username
WP_ADMIN_PASSWORD=your_secure_password

# AI Model API Keys (Gemini / DeepSeek / OpenAI)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Search Engines Indexing Credentials
INDEXNOW_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Social Syndication
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Cloudflare Credentials (for DNS, SSL, WAF Automation)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMAIL=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ZONE_ID=

# aaPanel & VPS Server Credentials (for Cloud & VPS DevOps Suite)
VPS_HOST=
VPS_SSH_PORT=22
VPS_SSH_USER=root
VPS_SSH_PASSWORD=
AAPANEL_URL=
AAPANEL_API_KEY=
